msgstr "MODがあるゲーム"

msgid "All games"
msgstr "すべてのゲーム"

msgid "Recently played"
msgstr "最近遊んだゲーム"

msgid "No game on these drives was played from RiftWii yet. Press 1 for all games."
msgstr "これらのドライブのゲームはまだRiftWiiで遊んでいません。1ですべてのゲームを表示します。"

msgid "{1}/{2}"
msgstr "{1}/{2}"

msgid "Played once, on {1}"
msgstr "{1}に1回遊びました"

msgid "Played {1} times, last on {2}"
msgstr "{1}回遊びました (最後は{2})"

msgid "1: filter   2: settings   +: rescan"
msgstr "1: 絞り込み   2: 設定   +: 再検索"

msgid "Page {1} of {2}"
msgstr "{1} / {2} ページ"

