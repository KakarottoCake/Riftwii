msgstr "{1}: /wbfs と /games にゲームがありません"

msgid "SD: no card"
msgstr "SD: カードがありません"

msgid "No d2x cIOS in 249-251: games cannot boot yet"
msgstr "249〜251にd2x cIOSがありません: まだゲームを起動できません"

