msgstr "{1}個のXMLは他のゲーム用です"

msgid "Package scan failed; go back and try again"
msgstr "パックの読み込みに失敗しました。もどってやり直してください"

msgid "This XML cannot be read; the error is listed under it."
msgstr "このXMLは読み込めません。エラーは下に表示されています。"

msgid "This XML cannot be read; fix it on the card and come back."
msgstr "このXMLは読み込めません。カード上で直してからもどってください。"

msgid "This pack cannot be turned on."
msgstr "このパックはオンにできません。"

msgid "Off. A turns it on."
msgstr "オフ。Aでオンになります。"

msgid "Off. A turns it on and shows its setting."
msgstr "オフ。Aでオンになり、設定が表示されます。"

msgid "Off. A turns it on and shows its {1} settings."
msgstr "オフ。Aでオンになり、{1}個の設定が表示されます。"

msgid "On. It applies as a whole."
msgstr "オン。まとめて適用されます。"

msgid "On, but nothing chosen yet: pick its settings below."
msgstr "オンですが、まだ何も選ばれていません。下で設定を選んでください。"

msgid "On, {1} of {2} settings chosen."
msgstr "オン。{2}個中{1}個の設定を選択中。"

msgid "No game is selected; go back and pick one."
msgstr "ゲームが選ばれていません。もどって選んでください。"

msgid "Preparing the mods..."
msgstr "MODを準備しています..."

msgid "Cheats"
msgstr "チート"

msgid "Picture width"
msgstr "画面の幅"

msgid "Deflicker"
msgstr "ちらつき防止"

msgid "Black borders"
msgstr "黒い枠"

msgid "Framebuffer"
msgstr "フレームバッファ"

msgid "704 pixels"
msgstr "704ピクセル"

msgid "720 pixels (full)"
msgstr "720ピクセル (全体)"

msgid "Game's own"
msgstr "ゲームのまま"

msgid "Off (sharp)"
msgstr "オフ (くっきり)"

msgid "Low"
msgstr "弱"

msgid "Medium"
msgstr "中"

msgid "High"
msgstr "強"

msgid "Remove"
msgstr "なくす"

msgid "Keep"
msgstr "そのまま"

