msgid "RiftWii copies {1} into sd:/riftwii/{2} ({3}). The game then gets the image as its SD card, so it can be on the SD card too. This takes about {4} minutes."
msgstr "O RiftWii copia {1} em sd:/riftwii/{2} ({3}). O jogo então usa a imagem como seu cartão SD, assim ele também pode ficar no cartão SD. Isso leva cerca de {4} minutos."

msgid "It is saved in {1} parts, as a FAT32 card holds no file of 4 GB."
msgstr "É salva em {1} partes, já que um cartão em FAT32 não suporta arquivos de 4 GB."

msgid "It replaces the {1} there now."
msgstr "Substitui o {1} que está lá agora."

msgid "Make an SD image?"
msgstr "Criar uma imagem SD?"

