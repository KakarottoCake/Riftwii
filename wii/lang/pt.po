msgstr "Faltam {1} minutos"

msgid "{1} seconds left"
msgstr "Faltam {1} segundos"

msgid "Free space"
msgstr "Espaço livre"

msgid "Stopped. Nothing was kept."
msgstr "Interrompido. Nada foi guardado."

