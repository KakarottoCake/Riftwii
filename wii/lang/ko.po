msgstr "이 게임에 대한 치트 정보는 온라인에서 찾을 수 없습니다."

msgid "This cheat has values to fill in (the X's). Edit the file first."
msgstr "이 치트에는 값을 채워 넣어야 할 부분(X로 표시된 곳)이 있습니다. 먼저 파일을 편집하세요."

msgid "Cheats are only applied when this is On."
msgstr "이 기능이 켜져 있을 때만 치트가 적용됩니다."

msgid "Replaces the file with the latest cheats from the GeckoCodes archive."
msgstr "GeckoCodes 아카이브의 최신 치트 파일로 교체합니다."

msgid "Downloads are off in Settings."
msgstr "설정에서 다운로드 기능이 꺼져 있습니다."

msgid "No game is selected."
msgstr "선택된 게임이 없습니다."

msgid "No cheat file yet. Choose Download to get one."
msgstr "아직 치트 파일이 없습니다. 다운로드를 선택하여 파일을 받으세요."

msgid "No cheat file at {1}"
msgstr "{1}에 치트 파일이 없"

msgid "The cheat file has no cheats in it: {1}"
msgstr "치트 파일에 치트 없음: {1}"

msgid "Settings"
msgstr "설정"

msgid "Language"
msgstr "언어"

msgid "Wii: {1}"
msgstr "Wii: {1}"

msgid "Download names and cheats"
msgstr "이름 및 치트 다운로드"

msgid "Get the latest game names"
msgstr "최신 게임 이름 확인"

msgid "Update"
msgstr "업데이트"

msgid "Menu IOS"
msgstr "메뉴 IOS"

msgid "Menu IOS: IOS 58 (no d2x cIOS found)"
msgstr "메뉴 IOS: IOS 58 (d2x cIOS를 찾을 수 없음)"

msgid "Find network packs (RiiFS)"
msgstr "네트워크 팩 (RiiFS) 찾기"

