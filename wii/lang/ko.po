msgstr "다운로드"

msgid "Edit first"
msgstr "먼저 편집"

msgid "The cheats are in {1}. Edit it on a computer to add your own."
msgstr "치트가 {1}에 있습니다. 컴퓨터에서 편집하여 직접 추가할 수 있습니다."

msgid "Downloading cheats..."
msgstr "치트 다운로드..."

