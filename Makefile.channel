# Builds the RiftWii channel (docs/CHANNEL.md): its boot program
# (channel/loader), the forwarder (channel/forwarder) that one starts, the
# package tools/make_channel.py makes of them and the banner, and the
# installer app that carries that package
# (channel/installer), build-channel/installer.dol. The release zip ships
# the installer as apps/riftwii_channel; RiftWii itself carries none of it.
#
#   export DEVKITPRO=/opt/devkitpro DEVKITPPC=/opt/devkitpro/devkitPPC
#   make -f Makefile.channel
#
# A Wii and a vWii start a channel differently (docs/CHANNEL.md), and the
# channel comes in two packages, which the installer picks between:
# - vWii: the loader (0x80003400-0x8000ffff) starts the forwarder, linked
#   above it (0x80100000);
# - Wii: the forwarder is the boot program, linked where homebrew usually
#   is (0x80004000), with channel/forwarder/start.S added at 0x80003400.
# The installer is at 0x80004000 too; all below RiftWii (0x80a00000 up).
ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

include $(DEVKITPPC)/wii_rules

OUT      := build-channel
OBJDIR   := $(OUT)/obj
FWDOL    := $(OUT)/forwarder.dol
FWELF    := $(OUT)/forwarder.elf
FWWIIDOL := $(OUT)/forwarder_wii.dol
FWWIIELF := $(OUT)/forwarder_wii.elf
FWSTART  := $(OUT)/start.bin
PACKAGES := $(OUT)/riftwii_channel_vwii.bin $(OUT)/riftwii_channel_wii.bin
INSTDOL  := $(OUT)/installer.dol
INSTELF  := $(OUT)/installer.elf
PYTHON   ?= python3
ART      := $(wildcard channel/art/*)

CFLAGS   := -O2 -Wall -Wextra -Werror $(MACHDEP) -I$(OBJDIR) -Ichannel/common -I$(LIBOGC_INC)
CXXFLAGS := $(CFLAGS) -std=gnu++17 -fno-exceptions -fno-rtti -Ivendor-bearssl/inc
FWLD     := $(MACHDEP) -Wl,-Map,$(OUT)/forwarder.map -Wl,--section-start,.init=0x80100000
FWWIILD  := $(MACHDEP) -Wl,-Map,$(OUT)/forwarder_wii.map
INSTLD   := $(MACHDEP) -Wl,-Map,$(OUT)/installer.map

.PHONY: all clean bearssl
all: $(INSTDOL)

$(OBJDIR):
	@mkdir -p $(OBJDIR)

# ---- the forwarder
# The start screen's pictures are committed (channel/forwarder/data, from
# tools/make_channel_art.py); bin2s turns each into a symbol and header.
SPLASH   := splash_bg.rgb splash_rift.a splash_word.rgba
SPLASHO  := $(foreach f,$(SPLASH),$(OBJDIR)/$(subst .,_,$(f)).o)

$(OBJDIR)/%_rgb.o $(OBJDIR)/%_rgb.h: channel/forwarder/data/%.rgb | $(OBJDIR)
	@echo $(notdir $<)
	@cd $(OBJDIR) && cp ../../$< . && bin2s -a 32 -H $*_rgb.h $(notdir $<) | $(AS) -o $*_rgb.o

$(OBJDIR)/%_rgba.o $(OBJDIR)/%_rgba.h: channel/forwarder/data/%.rgba | $(OBJDIR)
	@echo $(notdir $<)
	@cd $(OBJDIR) && cp ../../$< . && bin2s -a 32 -H $*_rgba.h $(notdir $<) | $(AS) -o $*_rgba.o

$(OBJDIR)/%_a.o $(OBJDIR)/%_a.h: channel/forwarder/data/%.a | $(OBJDIR)
	@echo $(notdir $<)
	@cd $(OBJDIR) && cp ../../$< . && bin2s -a 32 -H $*_a.h $(notdir $<) | $(AS) -o $*_a.o

$(OBJDIR)/fw_main.o: channel/forwarder/main.c channel/forwarder/data/splash.h $(SPLASHO) | $(OBJDIR)
	@echo $(notdir $<)
	@$(CC) $(CFLAGS) -Ichannel/forwarder/data -c $< -o $@

$(OBJDIR)/dolboot.o: channel/common/dolboot.c channel/common/dolboot.h | $(OBJDIR)
	@echo $(notdir $<)
	@$(CC) $(CFLAGS) -c $< -o $@

$(FWELF): $(OBJDIR)/fw_main.o $(OBJDIR)/dolboot.o $(SPLASHO)
	@echo linking ... $(notdir $@)
	@$(CC) $(FWLD) $^ -L$(LIBOGC_LIB) -lfat -logc -lm -o $@

$(FWDOL): $(FWELF)
	@echo output ... $(notdir $@)
	@elf2dol $< $@

$(FWWIIELF): $(OBJDIR)/fw_main.o $(OBJDIR)/dolboot.o $(SPLASHO)
	@echo linking ... $(notdir $@)
	@$(CC) $(FWWIILD) $^ -L$(LIBOGC_LIB) -lfat -logc -lm -o $@

$(FWWIIDOL): $(FWWIIELF)
	@echo output ... $(notdir $@)
	@elf2dol $< $@

# The Wii forwarder's first code (channel/forwarder/start.S), as raw
# instructions for tools/make_channel.py to put at 0x80003400.
$(FWSTART): channel/forwarder/start.S | $(OBJDIR)
	@echo $(notdir $<)
	@$(CC) $(MACHDEP) -x assembler-with-cpp -c $< -o $(OBJDIR)/fw_start.o
	@$(OBJCOPY) -O binary -j .text $(OBJDIR)/fw_start.o $@

# ---- the loader: the channel's boot program, with no library
LDRDOL   := $(OUT)/loader.dol
LDRELF   := $(OUT)/loader.elf
LDRFLAGS := -O2 -Wall -Wextra -Werror -mcpu=750 -meabi -mhard-float -mno-sdata \
            -ffreestanding -fno-builtin -fno-tree-loop-distribute-patterns

$(OBJDIR)/ldr_start.o: channel/loader/start.S | $(OBJDIR)
	@echo $(notdir $<)
	@$(CC) $(LDRFLAGS) -x assembler-with-cpp -c $< -o $@

$(OBJDIR)/ldr_loader.o: channel/loader/loader.c | $(OBJDIR)
	@echo $(notdir $<)
	@$(CC) $(LDRFLAGS) -c $< -o $@

$(LDRELF): $(OBJDIR)/ldr_start.o $(OBJDIR)/ldr_loader.o channel/loader/loader.ld
	@echo linking ... $(notdir $@)
	@$(CC) $(LDRFLAGS) -nostartfiles -nostdlib -T channel/loader/loader.ld -Wl,-Map,$(OUT)/loader.map \
		$(filter %.o,$^) -lgcc -o $@

$(LDRDOL): $(LDRELF)
	@echo output ... $(notdir $@)
	@elf2dol $< $@

# ---- the packages: the banner (channel/art) and, for a vWii, the loader
# and the forwarder, for a Wii the forwarder with start.S
$(PACKAGES) &: $(LDRDOL) $(FWDOL) $(FWSTART) $(FWWIIDOL) tools/make_channel.py $(ART)
	@$(PYTHON) tools/make_channel.py build $(LDRDOL) $(FWDOL) $(FWSTART) $(FWWIIDOL) channel/art $(OUT)

$(OBJDIR)/riftwii_channel_%_bin.o $(OBJDIR)/riftwii_channel_%_bin.h: $(OUT)/riftwii_channel_%.bin | $(OBJDIR)
	@echo $(notdir $<)
	@cd $(OBJDIR) && cp ../riftwii_channel_$*.bin . && bin2s -a 32 -H riftwii_channel_$*_bin.h riftwii_channel_$*.bin | $(AS) -o riftwii_channel_$*_bin.o

# ---- the installer
bearssl:
	@$(MAKE) --no-print-directory -f Makefile.bearssl

$(OBJDIR)/inst_main.o: channel/installer/main.cpp channel/installer/install.hpp | $(OBJDIR)
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/install.o: channel/installer/install.cpp channel/installer/install.hpp $(OBJDIR)/riftwii_channel_vwii_bin.h $(OBJDIR)/riftwii_channel_wii_bin.h | $(OBJDIR)
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -I$(OUT) -c $< -o $@

$(INSTELF): $(OBJDIR)/inst_main.o $(OBJDIR)/install.o $(OBJDIR)/dolboot.o $(OBJDIR)/riftwii_channel_vwii_bin.o $(OBJDIR)/riftwii_channel_wii_bin.o bearssl
	@echo linking ... $(notdir $@)
	@$(CXX) $(INSTLD) $(filter %.o,$^) -L$(LIBOGC_LIB) -Lbuild-bearssl -lbearssl -lwiiuse -lbte -lfat -logc -lm -o $@

$(INSTDOL): $(INSTELF)
	@echo output ... $(notdir $@)
	@elf2dol $< $@

clean:
	rm -rf $(OUT)
