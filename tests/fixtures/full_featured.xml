      <param name="pack" value="mirror"/>
    </macro>
  </options>
  <patch id="levels" root="/levels">
    <folder disc="/Stage" external="{$pack}/Stage" recursive="true" create="true"/>
    <file disc="/Stage/intro.arc" external="{$pack}/intro.arc" offset="0x20" length="0x100" resize="false"/>
  </patch>
  <patch id="codes">
    <file disc="/main.dol" external="/codes/main.dol"/>
    <memory offset="0x80001800" value="4E800020"/>
    <memory offset="0x80001804" valuefile="/codes/blob.bin" original="00000000"/>
    <memory value="7C0802A6" offset="0x80004000" ocarina="true"/>
    <memory original="38600001" value="38600000" search="true" align="4"/>
  </patch>
  <patch id="save">
    <savegame external="/save/{$__gameid}" clone="yes"/>
  </patch>
