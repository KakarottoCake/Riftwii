    <region type="E"/>
    <region type="P"/>
  </id>
  <options>
    <section name="Levels">
      <option name="Level pack" id="pack" default="1">
        <choice name="Pack A">
          <patch id="levels"/>
          <param name="pack" value="a"/>
        </choice>
        <choice name="Pack B">
          <patch id="levels"/>
          <param name="pack" value="b"/>
        </choice>
