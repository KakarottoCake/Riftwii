# SPDX-FileCopyrightText: 2026 RiftWii contributors
# SPDX-License-Identifier: GPL-3.0-or-later
# Builds RiftWii's plugins (docs/PLUGINS.md) with devkitPPC: one .rwp per
# folder in PLUGINS, from plugins/<name>/*.c. Makefile.wii runs it before
# the DOL is linked and passes the version and build stamp the DOL is
# built with, so the two always match:
#
#   make -f Makefile.wii plugins
#
# Each plugin is linked twice, at 0 (with --emit-relocs) and at another
# base; tools/make_plugin.py takes both, as Makefile.runtime and
# tools/rtreloc.py do for the RVZ blob, and refuses a plugin with an
# undefined symbol, a forbidden section, more memory than the arena, or a
# relocation list that does not turn the one link into the other. Out:
#
#   build-plugins/<name>.rwp                       for the size report
#   build-plugins/plugins/<name>.<version>.rwp     sd:/apps/riftwii/plugins/
ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif
ifeq ($(strip $(RIFTWII_VERSION)),)
$(error "Makefile.plugin is run by Makefile.wii, which passes RIFTWII_VERSION and RIFTWII_BUILD_STAMP: make -f Makefile.wii plugins")
endif
ifeq ($(strip $(RIFTWII_BUILD_STAMP)),)
$(error "Makefile.plugin is run by Makefile.wii, which passes RIFTWII_VERSION and RIFTWII_BUILD_STAMP: make -f Makefile.wii plugins")
endif

PREFIX  := $(DEVKITPPC)/bin/powerpc-eabi-
CC      := $(PREFIX)gcc
PYTHON  ?= python3

PLUGINS := selftest
OUT     := build-plugins
SDDIR   := $(OUT)/plugins
ALT_BASE := 0x12340000

# Makefile.runtime's freestanding flags, with the loader's floating point
# (hard: a plugin runs in RiftWii, not in a game) and data sections, so
# --gc-sections keeps only what the entry points reach.
CFLAGS  := -Os -mcpu=750 -meabi -mhard-float -msdata=none \
           -ffreestanding -nostdlib -fno-builtin \
           -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables -fno-exceptions \
           -fno-stack-protector -fno-common -ffunction-sections -fdata-sections -std=c99 \
           -Wall -Wextra -Wpedantic -Werror -Iinclude
LDFLAGS := -nostdlib -nostartfiles -static -Wl,--build-id=none -Wl,--gc-sections \
           -Wl,--undefined=rwp_init -Wl,--undefined=rwp_exports -T plugins/plugin.ld

.PHONY: all clean
all: $(foreach p,$(PLUGINS),$(SDDIR)/$(p).$(RIFTWII_VERSION).rwp)

# The stamp the plugins are sealed with; rewritten only when it changes,
# so a new commit re-seals them without compiling them again.
STAMP_FILE := $(OUT)/build-stamp.txt
$(shell mkdir -p $(OUT) && [ "$$(cat $(STAMP_FILE) 2>/dev/null)" = "$(RIFTWII_BUILD_STAMP)" ] || echo "$(RIFTWII_BUILD_STAMP)" > $(STAMP_FILE))

define plugin_rules
$(OUT)/$(1)/%.o: plugins/$(1)/%.c include/riftwii/plugin_api.h
	@mkdir -p $$(dir $$@)
	$$(CC) $$(CFLAGS) -c -o $$@ $$<

$(1)_OBJS := $$(patsubst plugins/$(1)/%.c,$(OUT)/$(1)/%.o,$$(wildcard plugins/$(1)/*.c))

$(OUT)/$(1)/$(1).elf: $$($(1)_OBJS) plugins/plugin.ld
	$$(CC) $$(CFLAGS) $$(LDFLAGS) -Wl,--emit-relocs -Wl,-Map,$(OUT)/$(1)/$(1).map -Wl,--defsym,RWP_BASE=0 \
		-o $$@ $$($(1)_OBJS) -lgcc

$(OUT)/$(1)/$(1)_alt.elf: $$($(1)_OBJS) plugins/plugin.ld
	$$(CC) $$(CFLAGS) $$(LDFLAGS) -Wl,--defsym,RWP_BASE=$(ALT_BASE) -o $$@ $$($(1)_OBJS) -lgcc

# Other versions' files of this plugin leave the output folder, so it
# holds exactly what the zip carries.
$(OUT)/$(1).rwp $(SDDIR)/$(1).$(RIFTWII_VERSION).rwp: $(OUT)/$(1)/$(1).elf $(OUT)/$(1)/$(1)_alt.elf \
		tools/make_plugin.py include/riftwii/plugin_api.h $(STAMP_FILE)
	@mkdir -p $(SDDIR)
	@rm -f $(SDDIR)/$(1).*.rwp
	@$$(PYTHON) tools/make_plugin.py build --elf $(OUT)/$(1)/$(1).elf --alt-elf $(OUT)/$(1)/$(1)_alt.elf \
		--alt-base $(ALT_BASE) --name $(1) --stamp $(RIFTWII_BUILD_STAMP) --out $(OUT)/$(1).rwp
	@cp $(OUT)/$(1).rwp $(SDDIR)/$(1).$(RIFTWII_VERSION).rwp
endef
$(foreach p,$(PLUGINS),$(eval $(call plugin_rules,$(p))))

clean:
	@rm -rf $(OUT)
