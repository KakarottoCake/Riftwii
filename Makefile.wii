#---------------------------------------------------------------------------------
# Clear the implicit built in rules
#---------------------------------------------------------------------------------
.SUFFIXES:
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

include $(DEVKITPPC)/wii_rules
export	FREETYPE_CFLAGS	:=	-I$(DEVKITPRO)/portlibs/ppc/include/freetype2
export	FREETYPE_LIBS	:=	-lfreetype

#---------------------------------------------------------------------------------
# TARGET is the name of the output
# BUILD is the directory where object files & intermediate files will be placed
# SOURCES is a list of directories containing source code
# INCLUDES is a list of directories containing extra header files
#---------------------------------------------------------------------------------
TARGET		:=	riftwii
BUILD		:=	build_wii
SOURCES		:=	wii src runtime vendor-pugixml/src \
				vendor-libgui/source/libwiigui \
				vendor-libgui/source
# wiidrc.c (FIX94's Wii U GamePad driver) is compiled in: the menus read
# the GamePad through it, guarded so plain Wii and Dolphin are unaffected.
EXCLUDES	:=	vendor-libgui/source/demo.cpp vendor-libgui/source/menu.cpp vendor-libgui/source/filebrowser.cpp
INCLUDES	:=	wii vendor-libgui/source include runtime runtime/resident vendor-pugixml/src
DATA		:=	wii/assets vendor-libgui/source/images vendor-libgui/source/fonts vendor-libgui/source/sounds vendor-libgui/source/lang \
				build-runtime

#---------------------------------------------------------------------------------
# options for code generation
#---------------------------------------------------------------------------------
CFLAGS		=	-g -O2 -Wall -Wextra $(MACHDEP) $(INCLUDE) $(FREETYPE_CFLAGS)
CXXFLAGS	=	$(CFLAGS) -std=c++17
# Linked high so the game's DOL (0x80004000 up) and apploader (0x81200000)
# can be loaded while this program is still running; see wii/main.cpp.
LDFLAGS		=	-g $(MACHDEP) -Wl,-Map,$(notdir $@).map -Wl,--section-start,.init=0x80a00000

#---------------------------------------------------------------------------------
# any extra libraries we wish to link with the project
#---------------------------------------------------------------------------------
LIBS :=	-lpng -lz -lfat -lwiiuse -lbte -lasnd -logc -lvorbisidec -logg -lfreetype -lbrotlidec -lbrotlicommon -lbz2
#---------------------------------------------------------------------------------
# list of directories containing libraries, this must be the top level containing
# include and lib
#---------------------------------------------------------------------------------
LIBDIRS	:= $(PORTLIBS)

#---------------------------------------------------------------------------------
# no real need to edit anything past this point unless you need to add additional
# rules for different file extensions
#---------------------------------------------------------------------------------
PROJECT_ROOT ?= ..

# The release version, read from the one place it is bumped, so logs and
# bug reports can name the build (wii/main.cpp prints it).
RIFTWII_VERSION := $(shell grep -o 'Riftwii VERSION [0-9.]*' "$(PROJECT_ROOT)/CMakeLists.txt" 2>/dev/null | cut -d' ' -f3)$(shell grep -o 'RIFTWII_VERSION_SUFFIX "[^"]*"' "$(PROJECT_ROOT)/CMakeLists.txt" 2>/dev/null | cut -d'"' -f2)
CFLAGS		+=	-DRIFTWII_VERSION='"$(RIFTWII_VERSION)"'

ifneq ($(IN_BUILD),1)
#---------------------------------------------------------------------------------

export OUTPUT	:=	$(PROJECT_ROOT)/$(TARGETDIR)/$(TARGET)
export VPATH	:=	$(foreach dir,$(SOURCES),$(PROJECT_ROOT)/$(dir)) \
					$(foreach dir,$(DATA),$(PROJECT_ROOT)/$(dir))
export DEPSDIR	:=	$(PROJECT_ROOT)/$(BUILD)

#---------------------------------------------------------------------------------
# automatically build a list of object files for our project
#---------------------------------------------------------------------------------
CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
sFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
SFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.S)))
CFILES		:=	$(filter-out $(notdir $(EXCLUDES)),$(CFILES))
CPPFILES	:=	$(filter-out $(notdir $(EXCLUDES)),$(CPPFILES))
BINFILES	:=	$(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.ttf) \
					$(wildcard $(dir)/*.lang) $(wildcard $(dir)/*.png) \
					$(wildcard $(dir)/*.ogg) $(wildcard $(dir)/*.pcm)))
# Do not discover this through wildcard: the outer build evaluates BINFILES
# before runtime-blob creates build-runtime/riftwii_rt.bin. VPATH resolves it
# for the recursive build after runtime-blob has completed.
BINFILES	+=	riftwii_rt.bin

#---------------------------------------------------------------------------------
# use CXX for linking C++ projects, CC for standard C
#---------------------------------------------------------------------------------
ifeq ($(strip $(CPPFILES)),)
	export LD	:=	$(CC)
else
	export LD	:=	$(CXX)
endif

export OFILES_BIN	:=	$(addsuffix .o,$(BINFILES))
export OFILES_SOURCES := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(sFILES:.s=.o) $(SFILES:.S=.o)
export OFILES := $(OFILES_BIN) $(OFILES_SOURCES)

export HFILES := $(addsuffix .h,$(subst .,_,$(BINFILES)))

#---------------------------------------------------------------------------------
# build a list of include paths
#---------------------------------------------------------------------------------
export INCLUDE	:=	$(foreach dir,$(INCLUDES),-I$(PROJECT_ROOT)/$(dir)) \
				$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
				-I$(PROJECT_ROOT)/$(BUILD) -I$(LIBOGC_INC)

#---------------------------------------------------------------------------------
# build a list of library paths
#---------------------------------------------------------------------------------
export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib) \
					-L$(LIBOGC_LIB)

export OUTPUT	:=	$(PROJECT_ROOT)/$(TARGET)
.PHONY: $(BUILD) clean runtime-blob

#---------------------------------------------------------------------------------
$(BUILD): runtime-blob
	@[ -d $@ ] || mkdir -p $@
	@IN_BUILD=1 PROJECT_ROOT="$(PROJECT_ROOT)" $(MAKE) --no-print-directory -C "$(BUILD)" -f ../Makefile.wii

#---------------------------------------------------------------------------------
# The resident runtime (runtime/resident) is a separate freestanding build
# whose blob is embedded in the loader as riftwii_rt_bin.
runtime-blob:
	@$(MAKE) --no-print-directory -f Makefile.runtime

#---------------------------------------------------------------------------------
clean:
	@echo clean ...
	@rm -fr "$(BUILD)" "$(TARGET).elf" "$(TARGET).dol" build-runtime

#---------------------------------------------------------------------------------
run:
	wiiload "$(TARGET).dol"

#---------------------------------------------------------------------------------
reload:
	wiiload -r "$(TARGET).dol"

#---------------------------------------------------------------------------------
else

DEPENDS	:=	$(OFILES:.o=.d)

#---------------------------------------------------------------------------------
# main targets
#---------------------------------------------------------------------------------
$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES)

$(OFILES_SOURCES): $(HFILES)
# A version bump must not leave the old number in the DOL.
main.o: $(PROJECT_ROOT)/CMakeLists.txt
#---------------------------------------------------------------------------------
# This rule links in binary data with .ttf, .png, .ogg and .pcm extensions
#---------------------------------------------------------------------------------
%.ttf.o %_ttf.h : %.ttf
	@echo $(notdir $<)
	$(bin2o)

%.lang.o %_lang.h : %.lang
	@echo $(notdir $<)
	$(bin2o)

%.png.o %_png.h : %.png
	@echo $(notdir $<)
	$(bin2o)

%.ogg.o %_ogg.h : %.ogg
	@echo $(notdir $<)
	$(bin2o)

%.pcm.o %_pcm.h : %.pcm
	@echo $(notdir $<)
	$(bin2o)

%.bin.o %_bin.h : %.bin
	@echo $(notdir $<)
	$(bin2o)

-include $(DEPENDS)

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
