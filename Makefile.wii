# SPDX-FileCopyrightText: 2026 RiftWii contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#---------------------------------------------------------------------------------
# Clear the implicit built in rules
#---------------------------------------------------------------------------------
.SUFFIXES:
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

include $(DEVKITPPC)/wii_rules
# devkitPro's default bin2o leaves mktemp's path unquoted. Workspace-local
# temporary directories can contain spaces (as this Windows checkout does).
define bin2o
        $(eval _tmpasm := $(shell mktemp))
        $(SILENTCMD)bin2s -a 32 -H "$(subst .,_,$(<F)).h" "$<" > "$(_tmpasm)"
        $(SILENTCMD)$(CC) -x assembler-with-cpp $(CPPFLAGS) $(ASFLAGS) -c "$(_tmpasm)" -o "$(<F).o"
        @rm -f -- "$(_tmpasm)"
endef
export	FREETYPE_CFLAGS	:=	-I$(DEVKITPRO)/portlibs/ppc/include/freetype2
export	FREETYPE_LIBS	:=	-lfreetype

#---------------------------------------------------------------------------------
# TARGET is the name of the output
# BUILD is the directory where object files & intermediate files will be placed
# SOURCES is a list of directories containing source code
# INCLUDES is a list of directories containing extra header files
#---------------------------------------------------------------------------------
TARGET		:=	riftwii
BUILD		:=	build_wii
# wii/ and src/ are sorted into subfolders by area (docs/MAP.md); the build
# still puts every object in one folder, so base names stay unique.
WII_DIRS	:=	wii wii/core wii/menu wii/launch wii/hooks wii/controllers wii/storage wii/online
SRC_DIRS	:=	src/fs src/disc src/patching src/net src/art src/data
SOURCES		:=	$(WII_DIRS) $(SRC_DIRS) runtime vendor-pugixml/src vendor-zstd \
				vendor-libgui/source/libwiigui \
				vendor-libgui/source vendor-wwfc channel/common
# wiidrc.c (FIX94's Wii U GamePad driver) is compiled in: the menus read
# the GamePad through it, guarded so plain Wii and Dolphin are unaffected.
EXCLUDES	:=	vendor-libgui/source/demo.cpp vendor-libgui/source/menu.cpp vendor-libgui/source/filebrowser.cpp \
				vendor-libgui/source/gettext.cpp vendor-libgui/source/pngu.c
# What only the GameCube loader uses lives in the gamecube plugin
# (Makefile.plugin's gamecube_SRC, docs/PLUGINS.md "Stage (b)"), not in the
# DOL; the host tests still build these (CMakeLists.txt).
EXCLUDES	+=	src/patching/gclayout.cpp src/patching/gcclock.cpp src/patching/gcreset.cpp src/patching/gcexi.cpp src/patching/gcload.cpp src/patching/gcaram.cpp \
				src/patching/gcfont.cpp src/data/gccontrols.cpp
INCLUDES	:=	$(WII_DIRS) vendor-libgui/source include runtime runtime/resident runtime/pad runtime/gc runtime/shot runtime/fault runtime/vsd vendor-pugixml/src vendor-bearssl/inc vendor-wwfc vendor-zstd \
				channel/common
DATA		:=	wii/assets wii/lang vendor-gecko vendor-libgui/source/images vendor-libgui/source/fonts vendor-libgui/source/sounds vendor-libgui/source/lang \
				build-runtime

#---------------------------------------------------------------------------------
# options for code generation
#---------------------------------------------------------------------------------
CFLAGS		=	-g -O2 -Wall -Wextra $(MACHDEP) $(INCLUDE) $(FREETYPE_CFLAGS)
CXXFLAGS	=	$(CFLAGS) -std=c++17
# Linked high so the game's DOL (0x80004000 up) and apploader (0x81200000)
# can be loaded while this program is still running; see wii/main.cpp.
LDFLAGS		=	-g $(MACHDEP) -Wl,-Map,$(notdir $@).map -Wl,--section-start,.init=0x80a00000 -Wl,--wrap=_sbrk_r -Wl,--wrap=__CheckARGV -Wl,--wrap=dvmUnmountVolume -Wl,--wrap=wiiuse_init_cmd_queue

#---------------------------------------------------------------------------------
# any extra libraries we wish to link with the project
#---------------------------------------------------------------------------------
# libbearssl.a comes from Makefile.bearssl (the TLS client, wii/online/tls.cpp).
LIBS :=	-lbearssl -lz -lfat -lwiiuse -lbte -lasnd -logc -lvorbisidec -logg -lfreetype -lbz2
#---------------------------------------------------------------------------------
# list of directories containing libraries, this must be the top level containing
# include and lib
#---------------------------------------------------------------------------------
LIBDIRS	:= $(PORTLIBS)

#---------------------------------------------------------------------------------
# no real need to edit anything past this point unless you need to add additional
# rules for different file extensions
#---------------------------------------------------------------------------------
PROJECT_ROOT ?= ..

# The version, so logs and bug reports can name the build: the release's
# YYMM from CMakeLists.txt and, past it, "-" and the commits since its tag
# (2610-123), counted by git at every build (CMakeLists.txt says more).
RIFTWII_BASE := $(shell grep -o 'Riftwii VERSION [0-9]*' "$(PROJECT_ROOT)/CMakeLists.txt" 2>/dev/null | cut -d' ' -f3)
RIFTWII_BASE_TAG := $(shell grep -o 'RIFTWII_BASE_TAG "[^"]*"' "$(PROJECT_ROOT)/CMakeLists.txt" 2>/dev/null | cut -d'"' -f2)
RIFTWII_COMMITS := $(shell git -C "$(PROJECT_ROOT)" rev-list --count $(RIFTWII_BASE_TAG)..HEAD 2>/dev/null)
ifeq ($(IN_BUILD)$(strip $(RIFTWII_COMMITS)),1)
$(error cannot count the commits since $(RIFTWII_BASE_TAG): git and the tag are needed for the version)
endif
RIFTWII_VERSION := $(RIFTWII_BASE)$(if $(filter-out 0,$(RIFTWII_COMMITS)),-$(RIFTWII_COMMITS))
CFLAGS		+=	-DRIFTWII_VERSION='"$(RIFTWII_VERSION)"'
# The build stamp the DOL and its plugins share (docs/PLUGINS.md): the
# version and the commit, so a plugin from another build is refused even
# when the version number is the same (a local build of another branch).
RIFTWII_COMMIT := $(shell git -C "$(PROJECT_ROOT)" rev-parse --short=8 HEAD 2>/dev/null)
RIFTWII_BUILD_STAMP := $(RIFTWII_VERSION)-g$(or $(RIFTWII_COMMIT),unknown)
CFLAGS		+=	-DRIFTWII_BUILD_STAMP='"$(RIFTWII_BUILD_STAMP)"'
# Test builds: make WII_DEFINES=-DRIFTWII_TEST_LIMITS (wii/core/memlimits.hpp TestBallast).
CFLAGS		+=	$(WII_DEFINES)

ifneq ($(IN_BUILD),1)
#---------------------------------------------------------------------------------

export OUTPUT	:=	$(PROJECT_ROOT)/$(TARGETDIR)/$(TARGET)
export VPATH	:=	$(foreach dir,$(SOURCES),$(PROJECT_ROOT)/$(dir)) \
					$(foreach dir,$(DATA),$(PROJECT_ROOT)/$(dir))
export DEPSDIR	:=	$(PROJECT_ROOT)/$(BUILD)

#---------------------------------------------------------------------------------
# automatically build a list of object files for our project
#---------------------------------------------------------------------------------
# $(call files_in,<dirs>,<pattern>): the matching file names in all of
# <dirs>, sorted together.
files_in	=	$(sort $(foreach dir,$(1),$(notdir $(wildcard $(dir)/$(2)))))
OTHER_DIRS	:=	$(filter-out $(WII_DIRS) $(SRC_DIRS),$(SOURCES))
CFILES		:=	$(call files_in,$(WII_DIRS),*.c) $(call files_in,$(SRC_DIRS),*.c) \
				$(foreach dir,$(OTHER_DIRS),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(call files_in,$(WII_DIRS),*.cpp) $(call files_in,$(SRC_DIRS),*.cpp) \
				$(foreach dir,$(OTHER_DIRS),$(notdir $(wildcard $(dir)/*.cpp)))
sFILES		:=	$(call files_in,$(WII_DIRS),*.s) $(call files_in,$(SRC_DIRS),*.s) \
				$(foreach dir,$(OTHER_DIRS),$(notdir $(wildcard $(dir)/*.s)))
SFILES		:=	$(call files_in,$(WII_DIRS),*.S) $(call files_in,$(SRC_DIRS),*.S) \
				$(foreach dir,$(OTHER_DIRS),$(notdir $(wildcard $(dir)/*.S)))
CFILES		:=	$(filter-out $(notdir $(EXCLUDES)),$(CFILES))
CPPFILES	:=	$(filter-out $(notdir $(EXCLUDES)),$(CPPFILES))
BINFILES	:=	$(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.ttf) \
					$(wildcard $(dir)/*.lang) $(wildcard $(dir)/*.png) \
					$(wildcard $(dir)/*.ogg) $(wildcard $(dir)/*.pcm)))
# Do not discover this through wildcard: the outer build evaluates BINFILES
# before runtime-blob creates build-runtime/riftwii_rt.bin. VPATH resolves it
# for the recursive build after runtime-blob has completed. menufont.zst and
# licence.zst are made in the build (below) from wii/font/rounded.ttf and
# LICENSE. The GameCube runtime blobs (riftwii_gc*) are the gamecube
# plugin's (plugins/gamecube/gcblobs.S), not the DOL's.
BINFILES	+=	riftwii_rt.zst riftwii_rt_rvz.zst riftwii_rt_rvz.rel riftwii_pad.bin riftwii_shot.bin riftwii_fault.bin riftwii_wlog.bin riftwii_vsd.bin codehandleronly.bin
# The start-up stash (wii/core/stash.hpp): not linked, but added to the
# DOL as a section above .bss that crt0 copies to MEM2, so its MEM1 is
# the heap's after the start. The menu's font, the GPL's text (credits)
# and its translations (wii/lang/*.po), zstd-compressed.
export STASHFILES	:=	menufont.zst licence.zst \
					$(foreach dir,$(DATA),$(addsuffix .zst,$(notdir $(wildcard $(dir)/*.po))))

#---------------------------------------------------------------------------------
# use CXX for linking C++ projects, CC for standard C
#---------------------------------------------------------------------------------
ifeq ($(strip $(CPPFILES)),)
	export LD	:=	$(CC)
else
	export LD	:=	$(CXX)
endif

export OFILES_BIN	:=	$(addsuffix .o,$(BINFILES))
export OFILES_SOURCES := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(sFILES:.s=.o) $(SFILES:.S=.o)
export OFILES := $(OFILES_BIN) $(OFILES_SOURCES)

export HFILES := $(addsuffix .h,$(subst .,_,$(BINFILES)))

#---------------------------------------------------------------------------------
# build a list of include paths
#---------------------------------------------------------------------------------
export INCLUDE	:=	$(foreach dir,$(INCLUDES),-I$(PROJECT_ROOT)/$(dir)) \
				$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
				-I$(PROJECT_ROOT)/$(BUILD) -I$(LIBOGC_INC)

#---------------------------------------------------------------------------------
# build a list of library paths
#---------------------------------------------------------------------------------
export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib) \
					-L$(LIBOGC_LIB) -L$(PROJECT_ROOT)/build-bearssl

export OUTPUT	:=	$(PROJECT_ROOT)/$(TARGET)
.PHONY: $(BUILD) clean runtime-blob bearssl-lib plugins version print-version

#---------------------------------------------------------------------------------
# The plugins first (Makefile.plugin), from inside the build so they get
# the same version and build stamp as the DOL; the DOL's rule then checks
# that they match.
$(BUILD): runtime-blob bearssl-lib
	@[ -d $@ ] || mkdir -p $@
	@IN_BUILD=1 PROJECT_ROOT="$(PROJECT_ROOT)" $(MAKE) --no-print-directory -C "$(BUILD)" -f ../Makefile.wii plugins
	@IN_BUILD=1 PROJECT_ROOT="$(PROJECT_ROOT)" $(MAKE) --no-print-directory -C "$(BUILD)" -f ../Makefile.wii

plugins:
	@[ -d $(BUILD) ] || mkdir -p $(BUILD)
	@IN_BUILD=1 PROJECT_ROOT="$(PROJECT_ROOT)" $(MAKE) --no-print-directory -C "$(BUILD)" -f ../Makefile.wii plugins

#---------------------------------------------------------------------------------
# The resident runtime (runtime/resident) is a separate freestanding build
# whose blobs are embedded in the loader as riftwii_rt_bin and, for RVZ
# games, riftwii_rt_rvz_bin with its relocations riftwii_rt_rvz_rel.
runtime-blob:
	@$(MAKE) --no-print-directory -f Makefile.runtime

bearssl-lib:
	@$(MAKE) --no-print-directory -f Makefile.bearssl

#---------------------------------------------------------------------------------
clean:
	@echo clean ...
	@rm -fr "$(BUILD)" "$(TARGET).elf" "$(TARGET).dol" build-runtime build-bearssl build-plugins

#---------------------------------------------------------------------------------
# The version this checkout builds as (2610-123), without building: the
# release workflow names the tag and the zip by it. PROJECT_ROOT is the
# build folder's ".." up here, so the version is read in a make that is
# told the repository's own folder.
version:
	@$(MAKE) --no-print-directory -f Makefile.wii PROJECT_ROOT="$(CURDIR)" print-version

print-version:
	@echo $(RIFTWII_VERSION)

#---------------------------------------------------------------------------------
run:
	wiiload "$(TARGET).dol"

#---------------------------------------------------------------------------------
reload:
	wiiload -r "$(TARGET).dol"

#---------------------------------------------------------------------------------
else

DEPENDS	:=	$(OFILES:.o=.d)

#---------------------------------------------------------------------------------
# main targets
#---------------------------------------------------------------------------------
# The DOL is elf2dol's, plus the start-up stash as one more data section
# right above .bss (tools/dol_stash.py). The build fails if the stash
# would end past STASH_LIMIT: the game's apploader at 0x81200000, which is
# also where RiftWii's heap stops, and well below 0x81300000, where the
# Homebrew Channel refused a DOL section on a real Wii. riftwii.elf has
# no stash: start the .dol.
PYTHON		?=	python3
ZSTD		?=	zstd
STASH_LIMIT	:=	0x81200000
#
# Then every plugin in build-plugins/plugins must carry this DOL's build
# stamp and API version (tools/make_plugin.py check, as CI runs it).
#
# Last, the DOL is packed (tools/pack_dol.py, runtime/dolpack): its sections
# Zstandard-compressed behind a stub that unpacks them at start, half the
# file to download and read from the card. The checks above and
# tools/size_report.py read the unpacked one, kept as
# build_wii/riftwii-unpacked.dol. PACK=0 leaves riftwii.dol unpacked.
PLUGIN_FILES = $(wildcard $(PROJECT_ROOT)/build-plugins/plugins/*.rwp)
PACK		?=	1
UNPACKED	:=	$(CURDIR)/riftwii-unpacked.dol
DOLPACK_STUB	:=	$(PROJECT_ROOT)/build-runtime/dolpack.bin
$(OUTPUT).dol: $(OUTPUT).elf $(STASHFILES) $(PROJECT_ROOT)/tools/dol_stash.py $(PROJECT_ROOT)/tools/make_plugin.py \
		$(PROJECT_ROOT)/tools/pack_dol.py $(DOLPACK_STUB)
	@echo output ... $(notdir $@)
	@elf2dol $< "$(UNPACKED)"
	@$(PYTHON) $(PROJECT_ROOT)/tools/dol_stash.py "$(UNPACKED)" --version "$(RIFTWII_VERSION)" --limit $(STASH_LIMIT) \
		$(foreach f,$(STASHFILES),$(f)=$(f))
	@$(PYTHON) $(PROJECT_ROOT)/tools/make_plugin.py check --dol "$(UNPACKED)" --stamp "$(RIFTWII_BUILD_STAMP)" \
		--version "$(RIFTWII_VERSION)" $(PLUGIN_FILES)
ifeq ($(PACK),0)
	@cp "$(UNPACKED)" $@
else
	@$(PYTHON) $(PROJECT_ROOT)/tools/pack_dol.py "$(UNPACKED)" "$(DOLPACK_STUB)" "$@" --zstd $(ZSTD)
endif
$(OUTPUT).elf: $(OFILES)

# The plugins, built with this build's version and stamp (Makefile.plugin).
.PHONY: plugins
plugins:
	@$(MAKE) --no-print-directory -C "$(PROJECT_ROOT)" -f Makefile.plugin VPATH= \
		RIFTWII_VERSION="$(RIFTWII_VERSION)" RIFTWII_BUILD_STAMP="$(RIFTWII_BUILD_STAMP)"

$(OFILES_SOURCES): $(HFILES)
# A new version must not leave the old number in the DOL (2.7.0 RC8 to
# RC10 shipped with rc8 in online.cpp, so the updater kept offering an
# update to itself), and make does not see a changed -D. The version
# changes with every commit, so only the sources that use it are rebuilt:
# they depend on a stamp rewritten when the version differs.
$(OFILES_SOURCES): $(PROJECT_ROOT)/CMakeLists.txt
VERSION_STAMP := riftwii_version.stamp
VERSION_USERS := $(patsubst %.cpp,%.o,$(patsubst %.c,%.o,$(notdir $(shell grep -l -e RIFTWII_VERSION -e RIFTWII_BUILD_STAMP $(foreach dir,$(WII_DIRS) $(SRC_DIRS) runtime,$(PROJECT_ROOT)/$(dir)/*.c $(PROJECT_ROOT)/$(dir)/*.cpp) 2>/dev/null))))
$(shell [ "$$(cat $(VERSION_STAMP) 2>/dev/null)" = "$(RIFTWII_BUILD_STAMP)" ] || echo "$(RIFTWII_BUILD_STAMP)" > $(VERSION_STAMP))
$(VERSION_USERS): $(VERSION_STAMP)
#---------------------------------------------------------------------------------
# This rule links in binary data with .ttf, .png, .ogg and .pcm extensions
#---------------------------------------------------------------------------------
%.ttf.o %_ttf.h : %.ttf
	@echo $(notdir $<)
	$(bin2o)

%.lang.o %_lang.h : %.lang
	@echo $(notdir $<)
	$(bin2o)

# The menu's translations (wii/core/i18n.cpp), its font (main.cpp) and the GPL
# (credits.cpp) are zstd-compressed into the start-up stash (above) and
# unpacked when needed: none of them takes MEM1 after the start.
%.po.zst : %.po
	@echo $(notdir $@)
	@zstd -q -19 -f -o $@ $<

menufont.zst : $(PROJECT_ROOT)/wii/font/rounded.ttf
	@echo $(notdir $@)
	@zstd -q -19 -f -o $@ $<

licence.zst : $(PROJECT_ROOT)/LICENSE
	@echo $(notdir $@)
	@zstd -q -19 -f -o $@ $<

%.png.o %_png.h : %.png
	@echo $(notdir $<)
	$(bin2o)

%.ogg.o %_ogg.h : %.ogg
	@echo $(notdir $<)
	$(bin2o)

%.pcm.o %_pcm.h : %.pcm
	@echo $(notdir $<)
	$(bin2o)

%.bin.o %_bin.h : %.bin
	@echo $(notdir $<)
	$(bin2o)

# The RVZ runtime blob's relocations (tools/rtreloc.py).
%.rel.o %_rel.h : %.rel
	@echo $(notdir $<)
	$(bin2o)

# The runtime blobs, zstd-compressed by Makefile.runtime.
%.zst.o %_zst.h : %.zst
	@echo $(notdir $<)
	$(bin2o)

# The menu's own Zstandard (RVZ headers and the apploader's reads) is
# built for size, like the runtime's: it decodes a few MB per launch.
zstddeclib.o: CFLAGS += -Os

# The SD image maker waits on the card, not the CPU: built for size too.
vsdbuild.o vsdmake.o: CXXFLAGS += -Os

# The menu's screens wait on the player: built for size too, which
# leaves room for the transitions (keep the DOL's end below 0x81041980).
rift_menu.o: CXXFLAGS += -Os

# What waits on the network or the card, or runs once a launch: for size
# as well (the room the DOL keeps under 0x81041980 is the menu's margin).
online.o reportsend.o netpacks.o codebuilds.o autorun.o modplan.o: CXXFLAGS += -Os

# The plugin loader waits on the card too, and is the price of every MEM1
# saving a plugin brings: for size.
plugins.o pluginfile.o sha256.o: CXXFLAGS += -Os

# RiftWii's own sources build with -Werror, as the runtime and channel do;
# the vendored ones (pugixml's known warning, libgui, zstd) do not.
FIRST_PARTY_OBJS := $(patsubst %.cpp,%.o,$(patsubst %.c,%.o,$(notdir $(foreach dir,$(WII_DIRS) $(SRC_DIRS) runtime channel/common,$(wildcard $(PROJECT_ROOT)/$(dir)/*.c $(PROJECT_ROOT)/$(dir)/*.cpp)))))
$(FIRST_PARTY_OBJS): CFLAGS += -Werror

-include $(DEPENDS)

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
