# Builds the resident runtime blobs (runtime/resident) with devkitPPC:
# freestanding, no libc, position independent. Produces
# build-runtime/riftwii_rt.bin and, for RVZ games, riftwii_rt_rvz.bin with
# its relocations riftwii_rt_rvz.rel, which Makefile.wii embeds in the
# loader.
#
#   export DEVKITPRO=/opt/devkitpro DEVKITPPC=/opt/devkitpro/devkitPPC
#   make -f Makefile.runtime
#
# Position independence is checked by linking at two bases and comparing
# the binaries; .rodata/.data/.bss must be empty (all state is in the
# context inside .text, see rt_entry.S). The RVZ blob is the exception
# for .rodata, described below.
ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

PREFIX  := $(DEVKITPPC)/bin/powerpc-eabi-
CC      := $(PREFIX)gcc
OBJCOPY := $(PREFIX)objcopy
SIZE    := $(PREFIX)size

SRC     := runtime/resident
OUT     := build-runtime
BLOB    := $(OUT)/riftwii_rt.bin

CFLAGS  := -O2 -mcpu=750 -meabi -msoft-float -msdata=none \
           -ffreestanding -nostdlib -fno-builtin -fno-jump-tables \
           -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables \
           -fno-stack-protector -fno-common -ffunction-sections -std=c99 -Wall -Wextra -Wpedantic -Werror \
           -DRT_TARGET_PPC -I$(SRC) -Iruntime $(RT_DEFINES)
# --gc-sections drops what the trampolines do not reach (the table
# validator and CRC only run in the loader; the host tests use the rest).
LDFLAGS := -nostdlib -nostartfiles -static -Wl,--build-id=none -Wl,--gc-sections -T $(SRC)/rt.ld

OBJS    := $(OUT)/rt_entry.o $(OUT)/rt_hook.o $(OUT)/rtable.o $(OUT)/rtfat.o $(OUT)/rtfs.o

# The GameCube adapter blob (runtime/pad): PADRead and PADControlMotor
# hooks with the WUP-028 driver, installed only when the option is on.
PADSRC  := runtime/pad
PADOUT  := $(OUT)/pad
PADBLOB := $(OUT)/riftwii_pad.bin
PADOBJS := $(PADOUT)/pad_entry.o $(PADOUT)/pad_hook.o $(PADOUT)/rtgcad.o

# The RVZ blob (docs/RVZ.md): the same runtime built with RT_RVZ, plus
# RVZ packing and Zstandard. Zstandard's constant tables make it the one
# blob that is not position independent by itself; tools/rtreloc.py
# writes the relocations the loader applies, checked against the second
# link base.
RVZOUT  := $(OUT)/rvz
RVZBLOB := $(OUT)/riftwii_rt_rvz.bin
RVZREL  := $(OUT)/riftwii_rt_rvz.rel
RVZOBJS := $(RVZOUT)/rt_entry.o $(RVZOUT)/rt_hook.o $(RVZOUT)/rtable.o $(RVZOUT)/rtfat.o $(RVZOUT)/rtfs.o \
           $(RVZOUT)/rtrvz.o $(RVZOUT)/rt_zstd.o
# Zstandard is vendored code: its own warnings are not ours to fix, and
# -Os keeps it near 46 KB (libgcc supplies its register save and
# restore routines and 64-bit shifts, all position independent).
ZSTDFLAGS := -Os -mcpu=750 -meabi -msoft-float -msdata=none \
             -ffreestanding -nostdlib -fno-builtin -fno-jump-tables \
             -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables \
             -fno-stack-protector -fno-common -ffunction-sections -fdata-sections -std=gnu99 -w \
             -DRT_TARGET_PPC -DRT_RVZ -DZSTD_NO_INTRINSICS -DZSTD_DISABLE_ASM -DZSTD_NO_TRACE \
             -DXXH_NO_XXHASH_WARNINGS -I$(SRC) -Iruntime -Ivendor-zstd
PYTHON  ?= python3
# The loader embeds the two runtime blobs zstd-compressed (about half their
# size, which is MEM1 the menu keeps) and unpacks the one a game needs when
# it starts (wii/resident.cpp). zstd is the command-line tool.
ZSTD    ?= zstd
BLOBZST := $(OUT)/riftwii_rt.zst
RVZZST  := $(OUT)/riftwii_rt_rvz.zst

.PHONY: all clean
all: $(BLOB) $(PADBLOB) $(RVZBLOB) $(BLOBZST) $(RVZZST)

$(OUT)/%.zst: $(OUT)/%.bin
	$(ZSTD) -q -19 -f -o $@ $<

$(OUT):
	@mkdir -p $(OUT)

$(OUT)/rt_entry.o: $(SRC)/rt_entry.S $(SRC)/rt_hook.h | $(OUT)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OUT)/rt_hook.o: $(SRC)/rt_hook.c $(SRC)/rt_hook.h runtime/rtable.h runtime/rtfs.h runtime/rtfat.h | $(OUT)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OUT)/rtable.o: runtime/rtable.c runtime/rtable.h | $(OUT)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OUT)/rtfat.o: runtime/rtfat.c runtime/rtfat.h | $(OUT)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OUT)/rtfs.o: runtime/rtfs.c runtime/rtfs.h runtime/rtfat.h | $(OUT)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OUT)/riftwii_rt.elf: $(OBJS) $(SRC)/rt.ld
	$(CC) $(CFLAGS) $(LDFLAGS) -Wl,--defsym,RT_BASE=0x00000000 -o $@ $(OBJS)
	@$(SIZE) -A $@ | awk '$$1 ~ /^\.(rodata|data|bss)$$/ && $$2 != 0 { print "runtime: section " $$1 " is not empty (" $$2 " bytes); the blob would not be position independent"; bad = 1 } END { exit bad }'

$(OUT)/riftwii_rt_alt.elf: $(OBJS) $(SRC)/rt.ld
	$(CC) $(CFLAGS) $(LDFLAGS) -Wl,--defsym,RT_BASE=0x12340000 -o $@ $(OBJS)

$(BLOB): $(OUT)/riftwii_rt.elf $(OUT)/riftwii_rt_alt.elf
	$(OBJCOPY) -O binary $(OUT)/riftwii_rt.elf $@
	$(OBJCOPY) -O binary $(OUT)/riftwii_rt_alt.elf $(OUT)/riftwii_rt_alt.bin
	@cmp $@ $(OUT)/riftwii_rt_alt.bin || { echo "runtime: blob differs between link bases; not position independent"; rm -f $@; exit 1; }
	@echo "runtime blob: $$(stat -c %s $@) bytes"

$(PADOUT):
	@mkdir -p $(PADOUT)

$(PADOUT)/pad_entry.o: $(PADSRC)/pad_entry.S $(PADSRC)/pad_hook.h | $(PADOUT)
	$(CC) $(CFLAGS) -I$(PADSRC) -c -o $@ $<

$(PADOUT)/pad_hook.o: $(PADSRC)/pad_hook.c $(PADSRC)/pad_hook.h runtime/rtgcad.h | $(PADOUT)
	$(CC) $(CFLAGS) -I$(PADSRC) -c -o $@ $<

$(PADOUT)/rtgcad.o: runtime/rtgcad.c runtime/rtgcad.h | $(PADOUT)
	$(CC) $(CFLAGS) -c -o $@ $<

$(PADOUT)/riftwii_pad.elf: $(PADOBJS) $(PADSRC)/pad.ld
	$(CC) $(CFLAGS) -nostdlib -nostartfiles -static -Wl,--build-id=none -Wl,--gc-sections -T $(PADSRC)/pad.ld \
		-Wl,--defsym,RT_BASE=0x00000000 -o $@ $(PADOBJS)
	@$(SIZE) -A $@ | awk '$$1 ~ /^\.(rodata|data|bss)$$/ && $$2 != 0 { print "runtime: section " $$1 " is not empty (" $$2 " bytes) in the pad blob"; bad = 1 } END { exit bad }'

$(PADOUT)/riftwii_pad_alt.elf: $(PADOBJS) $(PADSRC)/pad.ld
	$(CC) $(CFLAGS) -nostdlib -nostartfiles -static -Wl,--build-id=none -Wl,--gc-sections -T $(PADSRC)/pad.ld \
		-Wl,--defsym,RT_BASE=0x12340000 -o $@ $(PADOBJS)

$(PADBLOB): $(PADOUT)/riftwii_pad.elf $(PADOUT)/riftwii_pad_alt.elf
	$(OBJCOPY) -O binary $(PADOUT)/riftwii_pad.elf $@
	$(OBJCOPY) -O binary $(PADOUT)/riftwii_pad_alt.elf $(PADOUT)/riftwii_pad_alt.bin
	@cmp $@ $(PADOUT)/riftwii_pad_alt.bin || { echo "runtime: pad blob differs between link bases; not position independent"; rm -f $@; exit 1; }
	@echo "pad blob: $$(stat -c %s $@) bytes"
$(RVZOUT):
	@mkdir -p $(RVZOUT)

$(RVZOUT)/rt_entry.o: $(SRC)/rt_entry.S $(SRC)/rt_hook.h | $(RVZOUT)
	$(CC) $(CFLAGS) -DRT_RVZ -c -o $@ $<

$(RVZOUT)/rt_hook.o: $(SRC)/rt_hook.c $(SRC)/rt_hook.h runtime/rtable.h runtime/rtfs.h runtime/rtfat.h runtime/rtrvz.h | $(RVZOUT)
	$(CC) $(CFLAGS) -DRT_RVZ -c -o $@ $<

$(RVZOUT)/rtable.o: runtime/rtable.c runtime/rtable.h | $(RVZOUT)
	$(CC) $(CFLAGS) -DRT_RVZ -c -o $@ $<

$(RVZOUT)/rtfat.o: runtime/rtfat.c runtime/rtfat.h | $(RVZOUT)
	$(CC) $(CFLAGS) -DRT_RVZ -c -o $@ $<

$(RVZOUT)/rtfs.o: runtime/rtfs.c runtime/rtfs.h runtime/rtfat.h | $(RVZOUT)
	$(CC) $(CFLAGS) -DRT_RVZ -c -o $@ $<

$(RVZOUT)/rtrvz.o: runtime/rtrvz.c runtime/rtrvz.h | $(RVZOUT)
	$(CC) $(CFLAGS) -DRT_RVZ -c -o $@ $<

$(RVZOUT)/rt_zstd.o: $(SRC)/rt_zstd.c $(SRC)/rt_hook.h vendor-zstd/zstddeclib.c | $(RVZOUT)
	$(CC) $(ZSTDFLAGS) -c -o $@ $<

$(RVZOUT)/riftwii_rt_rvz.elf: $(RVZOBJS) $(SRC)/rt_rvz.ld
	$(CC) $(CFLAGS) -nostdlib -nostartfiles -static -Wl,--build-id=none -Wl,--gc-sections -Wl,--emit-relocs \
		-T $(SRC)/rt_rvz.ld -Wl,--defsym,RT_BASE=0x00000000 -o $@ $(RVZOBJS) -lgcc
	@$(SIZE) -A $@ | awk '$$1 ~ /^\.(data|bss)$$/ && $$2 != 0 { print "runtime: section " $$1 " is not empty (" $$2 " bytes) in the RVZ blob"; bad = 1 } END { exit bad }'

$(RVZOUT)/riftwii_rt_rvz_alt.elf: $(RVZOBJS) $(SRC)/rt_rvz.ld
	$(CC) $(CFLAGS) -nostdlib -nostartfiles -static -Wl,--build-id=none -Wl,--gc-sections \
		-T $(SRC)/rt_rvz.ld -Wl,--defsym,RT_BASE=0x12340000 -o $@ $(RVZOBJS) -lgcc

$(RVZBLOB) $(RVZREL): $(RVZOUT)/riftwii_rt_rvz.elf $(RVZOUT)/riftwii_rt_rvz_alt.elf tools/rtreloc.py
	$(OBJCOPY) -O binary -j .text $(RVZOUT)/riftwii_rt_rvz.elf $(RVZBLOB)
	$(OBJCOPY) -O binary -j .text $(RVZOUT)/riftwii_rt_rvz_alt.elf $(RVZOUT)/riftwii_rt_rvz_alt.bin
	@$(PYTHON) tools/rtreloc.py $(RVZOUT)/riftwii_rt_rvz.elf $(RVZBLOB) $(RVZOUT)/riftwii_rt_rvz_alt.bin 0x12340000 $(RVZREL) \
		|| { rm -f $(RVZBLOB) $(RVZREL); exit 1; }
	@echo "RVZ runtime blob: $$(stat -c %s $(RVZBLOB)) bytes"

clean:
	rm -rf $(OUT)
